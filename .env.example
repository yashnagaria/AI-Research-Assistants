# Example environment variables for local development.
# Copy this file to `.env` in the PROJECT ROOT (not inside backend/) and fill in your key.
#
# Default provider is Google Gemini, whose free API key comes from:
#   https://aistudio.google.com/apikey
#
# The variable is named OPENAI_API_KEY because the backend uses the `openai`
# Python SDK to talk to any OpenAI-compatible endpoint. With OPENAI_BASE_URL
# set below, this is your Gemini key and no request reaches OpenAI.

OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

VECTOR_DB_PATH=db/faiss_index

# --- To use OpenAI instead (paid) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- To use a local Ollama model instead (free, no key) ---
# OPENAI_API_KEY=not-needed
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# EMBEDDING_MODEL=nomic-embed-text

# NOTE: changing EMBEDDING_MODEL changes the vector dimension, which makes
# existing FAISS indexes unreadable. After switching, delete
# backend/db/documents/ and backend/db/faiss_index* and re-upload.
