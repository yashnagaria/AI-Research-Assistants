# No API keys: Ollama runs both generation and embeddings locally.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=180
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
WEB_RESULTS_LIMIT=5
VECTOR_DB_PATH=db/faiss_index

# Changing OLLAMA_EMBEDDING_MODEL changes vector dimensions. Remove local indexes and
# re-upload documents after changing it.
